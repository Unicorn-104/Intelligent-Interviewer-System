# =====================================================================
# 后端服务器环境变量示例
# 用法：
#   1) 复制为 backend.env，填入真实值，权限设为 600
#   2) 启动前 source：set -a; . ./backend.env; set +a; ./run-backend.sh
#   3) 或用 systemd：EnvironmentFile=/home/ruoyi/backend.env
#
# 这些变量对应 application.yml / application-druid.yml 中的占位符，
# 默认值仍指向开发环境，服务器上按需覆盖即可，无需改动仓库里的 yml。
# =====================================================================

# --- MySQL（对应 spring.datasource.druid.master.*）---
DB_URL=jdbc:mysql://127.0.0.1:3306/recruit_agent?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_USERNAME=recruit_agent
DB_PASSWORD=change-me

# --- Redis（对应 spring.data.redis.*）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# 无密码时留空：REDIS_PASSWORD=
REDIS_PASSWORD=change-me
