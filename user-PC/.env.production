# 页面标题
VITE_APP_TITLE = 智聘 AI

# 生产环境配置
VITE_APP_ENV = 'production'

# 若依管理系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 生产环境默认保留后端接口能力
VITE_FRONTEND_ONLY = 'false'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip

# 企业端地址（面试链接入口页分派「我是面试官 / HR」时使用）
# 留空时按当前访问地址同源 + /enterprise 运行时拼接，部署端口或域名变化无需重新打包；
# 仅当企业端独立域名/端口时才填写完整地址（本地联调为 http://localhost:10081）
VITE_ENTERPRISE_APP_URL = ''
