<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AdMapper">

    <resultMap id="AdResult" type="com.ruoyi.system.domain.Ad">
        <id     property="advertId"          column="advert_id"          />
        <result property="title"             column="title"              />
        <result property="slotId"            column="slot_id"            />
        <result property="adType"             column="ad_type"            />
        <result property="mediaUrl"           column="media_url"          />
        <result property="richContent"        column="rich_content"       />
        <result property="jumpType"           column="jump_type"          />
        <result property="jumpUrl"            column="jump_url"           />
        <result property="startTime"         column="start_time"          />
        <result property="endTime"            column="end_time"            />
        <result property="dailyLimit"        column="daily_limit"         />
        <result property="totalLimit"        column="total_limit"          />
        <result property="exposure"           column="exposure"           />
        <result property="clicks"             column="clicks"             />
        <result property="ctr"                column="ctr"                />
        <result property="status"             column="status"             />
        <result property="slotName"           column="slot_name"          />
        <result property="createBy"            column="create_by"          />
        <result property="createTime"          column="create_time"        />
        <result property="updateBy"            column="update_by"          />
        <result property="updateTime"          column="update_time"        />
        <result property="remark"               column="remark"            />
    </resultMap>

    <sql id="selectAdVo">
        select a.ad_id as advert_id, 
               a.ad_title as title, 
               a.ad_slot_code as slot_id, 
               CAST(a.ad_type AS CHAR) as ad_type, 
               a.ad_media_url as media_url, 
               '' as rich_content,
               '' as jump_type,
               a.ad_jump_url as jump_url, 
               a.ad_start_at as start_time, 
               a.ad_end_at as end_time, 
               a.ad_freq_daily as daily_limit, 
               0 as total_limit,
               0 as exposure,
               0 as clicks,
               '' as ctr,
               CAST(a.ad_status AS CHAR) as status,
               s.slot_name,
               '' as create_by, 
               a.ad_created_at as create_time, 
               '' as update_by, 
               a.ad_updated_at as update_time, 
               '' as remark
        from t_ad a
        left join t_ad_slot s on a.ad_slot_code = s.slot_code
    </sql>

    <select id="selectAdList" parameterType="com.ruoyi.system.domain.Ad" resultMap="AdResult">
        <include refid="selectAdVo"/>
        <where>
            <if test="title != null and title != ''"> and a.ad_title like concat('%', #{title}, '%')</if>
            <if test="slotId != null and slotId != ''"> and a.ad_slot_code = #{slotId}</if>
            <if test="status != null and status != ''"> and a.ad_status = #{status}</if>
        </where>
        order by a.ad_created_at desc
    </select>

    <select id="selectAdByAdvertId" parameterType="Long" resultMap="AdResult">
        <include refid="selectAdVo"/>
        where a.ad_id = #{advertId}
    </select>

    <insert id="insertAd" parameterType="com.ruoyi.system.domain.Ad" useGeneratedKeys="true" keyProperty="advertId">
        insert into t_ad
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">ad_title,</if>
            <if test="slotId != null and slotId != ''">ad_slot_code,</if>
            <if test="adType != null and adType != ''">ad_type,</if>
            ad_media_url,
            <if test="jumpUrl != null and jumpUrl != ''">ad_jump_url,</if>
            <if test="startTime != null and startTime != ''">ad_start_at,</if>
            <if test="endTime != null and endTime != ''">ad_end_at,</if>
            <if test="dailyLimit != null">ad_freq_daily,</if>
            <if test="status != null and status != ''">ad_status,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="slotId != null and slotId != ''">#{slotId},</if>
            <if test="adType != null and adType != ''">#{adType},</if>
            <choose>
                <when test="mediaUrl != null and mediaUrl != ''">#{mediaUrl},</when>
                <otherwise>'',</otherwise>
            </choose>
            <if test="jumpUrl != null and jumpUrl != ''">#{jumpUrl},</if>
            <if test="startTime != null and startTime != ''">#{startTime},</if>
            <if test="endTime != null and endTime != ''">#{endTime},</if>
            <if test="dailyLimit != null">#{dailyLimit},</if>
            <if test="status != null and status != ''">#{status},</if>
        </trim>
    </insert>

    <update id="updateAd" parameterType="com.ruoyi.system.domain.Ad">
        update t_ad
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">ad_title = #{title},</if>
            <if test="slotId != null and slotId != ''">ad_slot_code = #{slotId},</if>
            <if test="adType != null and adType != ''">ad_type = #{adType},</if>
            <if test="mediaUrl != null and mediaUrl != ''">ad_media_url = #{mediaUrl},</if>
            <if test="jumpUrl != null and jumpUrl != ''">ad_jump_url = #{jumpUrl},</if>
            <if test="startTime != null and startTime != ''">ad_start_at = #{startTime},</if>
            <if test="endTime != null and endTime != ''">ad_end_at = #{endTime},</if>
            <if test="dailyLimit != null">ad_freq_daily = #{dailyLimit},</if>
            <if test="status != null and status != ''">ad_status = #{status},</if>
        </trim>
        where ad_id = #{advertId}
    </update>

    <update id="updateAdStatus" parameterType="com.ruoyi.system.domain.Ad">
        update t_ad
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null and status != ''">ad_status = #{status},</if>
        </trim>
        where ad_id = #{advertId}
    </update>

    <delete id="deleteAdByAdvertId" parameterType="Long">
        delete from t_ad where ad_id = #{advertId}
    </delete>

    <delete id="deleteAdByAdvertIds" parameterType="Long">
        delete from t_ad where ad_id in
        <foreach item="advertId" collection="array" open="(" separator="," close=")">
            #{advertId}
        </foreach>
    </delete>

</mapper>
