<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.IntegrationSecretMapper">

    <resultMap id="IntegrationSecretResult" type="com.ruoyi.system.domain.IntegrationSecret">
        <result property="id" column="isc_id"/>
        <result property="scope" column="isc_scope"/>
        <result property="key" column="isc_key"/>
        <result property="value" column="isc_value"/>
        <result property="status" column="isc_status"/>
        <result property="updatedAt" column="isc_updated_at"/>
    </resultMap>

    <select id="selectAll" resultMap="IntegrationSecretResult">
        select isc_id, isc_scope, isc_key, isc_value, isc_status, isc_updated_at
        from t_integration_secret
    </select>

    <select id="selectByScopeAndKey" resultMap="IntegrationSecretResult">
        select isc_id, isc_scope, isc_key, isc_value, isc_status, isc_updated_at
        from t_integration_secret
        where isc_scope = #{scope} and isc_key = #{key}
        limit 1
    </select>

    <update id="updateValueById">
        update t_integration_secret
        set isc_value = #{value}, isc_updated_at = now()
        where isc_id = #{id}
    </update>

</mapper>
