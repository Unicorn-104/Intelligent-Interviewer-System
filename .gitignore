# 仅跟踪项目源码目录；忽略根目录下的其他内容
/*
!/.gitignore
!/AGENTS.md
!/backend/
!/c-app/
!/admin_pc/
!/deploy/
!/user-PC/
!/docs/
!/enterprise_pc/
!/e-app/
!/e-app/**/

######################################################################
# 操作系统
######################################################################
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

######################################################################
# IDE / 编辑器
######################################################################
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
.springBeans

######################################################################
# 后端 (Java / Maven / Spring Boot)
######################################################################
target/
build/
.kotlin/
!**/src/**/build/
!.mvn/wrapper/maven-wrapper.jar
!.gradle/wrapper/gradle-wrapper.jar
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
rebel.xml

# Maven 依赖本地缓存（如有）
.mvn/wrapper/MavenWrapperDownloader.java

######################################################################
# 前端 (Node / Vue3 / Vite)
######################################################################
node_modules/
dist/
dist-ssr/
.npm/
.npm-cache/
.pnpm-store/
.yarn/
.pnp.*
*.local
# 本地 JS 报告
coverage/
*.lcov

######################################################################
# 日志 / 临时文件
######################################################################
logs/
*.log
*.log.err
*.xml.versionsBackup

######################################################################
# 敏感配置文件（含数据库 / Redis / Token 密钥，禁止入库）
######################################################################
c-app/.flutter_tool_state
# 后端数据源与 Druid 监控台账号密码
backend/ruoyi-admin/src/main/resources/application-druid.yml
# 后端主配置（含 JWT token secret / Redis 等）
backend/ruoyi-admin/src/main/resources/application.yml
# 本机 AI 私有配置；Spring Boot 从 backend/config/ 自动加载
backend/config/application.yml
# 本机启动说明含环境专用内容，不纳入源码交付
/c-app/启动与重启命令.md
# 其他本地环境覆盖配置
application-local.yml
application-local.properties
*.local.yml
*.local.properties

######################################################################
# 上传文件 / 运行时数据
######################################################################
upload/
uploadPath/
resume-pdf/
data/
# Flutter API source directories are not runtime data.
!/c-app/lib/features/*/data/
!/c-app/lib/features/*/data/*.dart
!/e-app/lib/features/**/data/
!/e-app/lib/features/**/data/*.dart
run/
																																	
######################################################################
# 已废弃的目录（已整合到 backend/，保留忽略防止误提交）
######################################################################
RuoYi-Vue/

######################################################################
# 其它
######################################################################
.claude/
.trae/
.factorypath

# Redis runtime dump
dump.rdb
backend/dump.rdb
*.log
# Python 本地验证缓存
__pycache__/
*.py[cod]

# Local SDK/cache and private developer notes are not application source.
/e-app/AndroidSDK/
/e-app/docs/local-backend-testing.md
# Database backups must remain local, even when previously staged.
/backend/doc/backup/

# Private certificate containers and local data exports are not source.
*.pfx
*.p12
/c-app/命令
/backend/doc/capp_mock_data_increment_20261016.sql
